# =================================================================
# VALATHI FUTURISTIC PORTFOLIO - SERVER ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: DO NOT commit your real '.env' file to Git or public repos!

# Server Port
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# =================================================================
# 1. AI CHATBOT (NOVA) CONFIGURATION
# =================================================================
# Choose your AI provider: 'gemini', 'openai', or leave blank for
# the built-in Smart Local Knowledge Base fallback (No API key needed!)
AI_PROVIDER=local

# Google Gemini API Key (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# =================================================================
# 2. CONTACT FORM EMAIL SERVICE (NODEMAILER)
# =================================================================
# To receive real emails from portfolio visitors, configure SMTP:
# Examples: Gmail, Outlook, SendGrid, Resend, or Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# For Gmail, use an App Password (not your normal password):
SMTP_PASS=your_gmail_app_password
# Email where contact messages will be delivered:
CONTACT_RECEIVER_EMAIL=valathi.dev@example.com
